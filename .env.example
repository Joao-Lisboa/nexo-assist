# Copie para .env e preencha. O .env nunca vai para o Git.

# Chave da API do Google Gemini (https://aistudio.google.com → Get API key)
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo usado pelo agent
LLM_MODEL=gemini-2.5-flash
# Orçamento de "raciocínio" do Gemini 2.5 por chamada (0 = desligado, mais rápido e barato)
LLM_THINKING_BUDGET=0

# Assina o cookie de sessão. Obrigatório em produção (mínimo 16 caracteres).
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Simulação do sistema de chamados legado
TICKET_SERVICE_FAILURE_RATE=0.08
TICKET_SERVICE_LATENCY_MS=120-450

# Proteção de custo: máximo de respostas do agent por dia (por instância)
MAX_AGENT_TURNS_PER_DAY=1000

# Pasta dos bancos SQLite (padrão: ./data)
# DATA_DIR=data
