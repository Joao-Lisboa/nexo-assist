# Copie para .env e preencha. O .env nunca vai para o Git.

# Provedores de LLM: preencha pelo menos UMA chave. Modelos de provedores sem
# chave são ignorados na cadeia abaixo.
#   Groq (plano gratuito sem cartão): https://console.groq.com/keys
GROQ_API_KEY=
#   Google Gemini (plano gratuito: 20 chamadas por dia por modelo): https://aistudio.google.com
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo principal, no formato provedor/modelo
LLM_MODEL=groq/openai/gpt-oss-120b
# Alternativos, tentados em ordem se o anterior estiver sobrecarregado (503),
# sem cota (429), lento (timeout) ou indisponível (404). Podem misturar provedores.
LLM_FALLBACK_MODELS=groq/openai/gpt-oss-20b,google/gemini-3.8-flash,google/gemini-3.5-flash-lite
# Raciocínio curto = respostas mais rápidas e baratas (as regras difíceis estão nas ferramentas)
LLM_REASONING_EFFORT=low
LLM_THINKING_LEVEL=low

# Assina o cookie de sessão. Obrigatório em produção (mínimo 16 caracteres).
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Simulação do sistema de chamados legado
TICKET_SERVICE_FAILURE_RATE=0.08
TICKET_SERVICE_LATENCY_MS=120-450

# Proteção de custo: máximo de respostas do agent por dia (por instância)
MAX_AGENT_TURNS_PER_DAY=1000

# Pasta dos bancos SQLite (padrão: ./data)
# DATA_DIR=data
